# =====================================================================
#  نمونه فایل پیکربندی Docker Compose — فقط یک مرجع است
#
#  ⚠️ این فایل را روی `.env` ننویسید!
#     `docker compose` خودکار فایل `.env` پروژه را می‌خواند؛ پس فقط
#     متغیرهایی که در `.env` نیستند را به همان فایل `.env` اضافه کنید.
#
#  متغیرهای الزامی (اگر در `.env` نیستند):
#      SECRET_KEY          یک رشته تصادفی حداقل ۵۰ کاراکتری
#      PAYMENT_SECRET      رشته‌ی مجزا برای امضای پرداخت
#      DATABASE_PASSWORD   رمز کاربر دیتابیس
#      MARIADB_ROOT_PASSWORD   فقط برای ساخت اولیه‌ی Volume
#
#  تفاوت اصلی Docker با محیط محلی:
#      DATABASE_HOST باید `db` باشد (نام سرویس در docker-compose).
#      این مقدار را خودِ docker-compose ست می‌کند؛ نیازی نیست در .env باشد.
# =====================================================================

# ---------- الزامی: بدون این‌ها docker compose اجرا نمی‌شود ----------
# یک رشته تصادفی حداقل ۵۰ کاراکتری
SECRET_KEY=
# یک رشته تصادفی مجزا برای امضای پرداخت (هرگز با SECRET_KEY یکسان نباشد)
PAYMENT_SECRET=
# رمز عبور کاربر دیتابیس
DATABASE_PASSWORD=
# رمز root دیتابیس (فقط برای ساخت اولیه)
MARIADB_ROOT_PASSWORD=

# ---------- پیکربندی عمومی ----------
DJANGO_SETTINGS_MODULE=config.settings.production
DATABASE_NAME=clothing_shop
DATABASE_USER=shop
DATABASE_PORT=3306

# میزبان/پورتی که کاربر نهایی با آن سایت را می‌بیند
ALLOWED_HOSTS=shop.example.com
CSRF_TRUSTED_ORIGINS=https://shop.example.com
WEB_PORT=8000

# ---------- اطلاعات فروشگاه ----------
STORE_NAME=پوشاک لوکس
STORE_PHONE=021-91001234
STORE_EMAIL=info@luxeclothing.ir
STORE_ADDRESS=تهران

# ---------- سرویس‌ها ----------
# console برای توسعه؛ در Production مسیر کلاس واقعی را بگذارید
SMS_PROVIDER=console
# mock فقط با DEBUG=True کار می‌کند
PAYMENT_GATEWAY=mock
LOG_LEVEL=INFO

# ---------- phpMyAdmin (اختیاری) ----------
PMA_PORT=8080
PMA_URI=http://localhost:8080/
