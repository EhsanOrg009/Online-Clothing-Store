# =====================================================================
#  فروشگاه اینترنتی پوشاک — نمونه فایل پیکربندی (.env.example)
#  یک نسخه از این فایل با نام .env بسازید و مقادیر واقعی را در آن قرار دهید.
#  فایل .env هرگز نباید وارد Git شود.
# =====================================================================

# ---------- هسته Django ----------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# فقط IP پراکسی‌هایی که مستقیماً به Django متصل می‌شوند؛ خالی = نادیده‌گرفتن X-Forwarded-For
TRUSTED_PROXY_IPS=

# development | production
DJANGO_SETTINGS_MODULE=config.settings.development

# ---------- دیتابیس MySQL ----------
DATABASE_NAME=clothing_shop
DATABASE_USER=shop
DATABASE_PASSWORD=change-me
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
# در صورت نیاز به SQLite فقط برای آزمایش سریع: mysql | sqlite3
DATABASE_ENGINE=mysql

# ---------- اطلاعات فروشگاه ----------
STORE_NAME=پوشاک لوکس
STORE_PHONE=021-00000000
STORE_EMAIL=info@example.com
STORE_ADDRESS=تهران، ایران

# ---------- پیامک (OTP) ----------
# console | <نام پرووایدر آینده>
SMS_PROVIDER=console
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=
# طول کد، اعتبار (ثانیه)، محدودیت تلاش، فاصله ارسال مجدد (ثانیه)
OTP_LENGTH=5
OTP_TTL_SECONDS=180
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=90
OTP_RESEND_LIMIT_PER_HOUR=5

# ---------- درگاه پرداخت ----------
# mock | <نام گیت‌وی آینده مانند zarinpal>
PAYMENT_GATEWAY=mock
PAYMENT_MERCHANT_ID=
PAYMENT_API_KEY=
PAYMENT_SECRET=change-me-to-a-long-random-string
# اعتبار سفارش در انتظار پرداخت (دقیقه)
ORDER_RESERVATION_MINUTES=30

# ---------- ارسال ----------
SHIPPING_FEE=50000
FREE_SHIPPING_MIN_AMOUNT=2000000

# ---------- امنیت (مقادیر production) ----------
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# ---------- لاگ ----------
LOG_LEVEL=INFO
