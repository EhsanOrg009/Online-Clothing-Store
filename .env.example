# =====================================================================
#  فروشگاه اینترنتی پوشاک — نمونه فایل پیکربندی (.env.example)
#  یک نسخه از این فایل با نام .env بسازید و مقادیر واقعی را در آن قرار دهید.
#  فایل .env هرگز نباید وارد Git شود.
# =====================================================================

# ---------- هسته Django ----------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# فقط IP پراکسی‌هایی که مستقیماً به Django متصل می‌شوند؛ خالی = نادیده‌گرفتن X-Forwarded-For
TRUSTED_PROXY_IPS=

# development | production
DJANGO_SETTINGS_MODULE=config.settings.development

# ---------- دیتابیس MySQL ----------
DATABASE_NAME=clothing_shop
DATABASE_USER=shop
DATABASE_PASSWORD=change-me
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
# در صورت نیاز به SQLite فقط برای آزمایش سریع: mysql | sqlite3
DATABASE_ENGINE=mysql

# ---------- اطلاعات فروشگاه ----------
STORE_NAME=پوشاک لوکس
STORE_PHONE=021-00000000
STORE_EMAIL=info@example.com
STORE_ADDRESS=تهران، ایران

# ---------- پیامک (OTP) ----------
# console | memory | sms_ir
SMS_PROVIDER=console
# تنظیمات SMS.ir (الزامی در صورت انتخاب SMS_PROVIDER=sms_ir)
SMS_IR_API_KEY=
SMS_IR_TEMPLATE_ID=
SMS_IR_OTP_PARAMETER_NAME=Code
SMS_IR_TIMEOUT_SECONDS=10
# تنظیمات سازگاری گذشته (اختیاری)
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=
# طول کد، اعتبار (ثانیه)، محدودیت تلاش، فاصله ارسال مجدد (ثانیه)
OTP_LENGTH=5
OTP_TTL_SECONDS=180
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=90
OTP_RESEND_LIMIT_PER_HOUR=5

# ---------- درگاه پرداخت ----------
# پیش‌فرض زیبال؛ برای ارائهٔ ترب‌پی نیز، فهرست را zibal,torobpay قرار دهید.
PAYMENT_GATEWAY=zibal
PAYMENT_GATEWAYS=
ZIBAL_MERCHANT=zibal
ZIBAL_TIMEOUT_SECONDS=10
ZIBAL_PAID_AT_TIMEZONE=
TOROBPAY_CLIENT_ID=
TOROBPAY_CLIENT_SECRET=
TOROBPAY_USERNAME=
TOROBPAY_PASSWORD=
TOROBPAY_BASE_URL=https://cpg.torobpay.com
TOROBPAY_TIMEOUT_SECONDS=10
TOROBPAY_TOKEN_REFRESH_BUFFER_SECONDS=300
TOROBPAY_ALLOWED_PAYMENT_HOSTS=cpg.torobpay.com,torobpay.com
# دامنه callback باید با دامنه ثبت‌شده در پنل زیبال مرتبط باشد.
SITE_URL=http://localhost:8000
# اعتبار سفارش در انتظار پرداخت (دقیقه)
ORDER_RESERVATION_MINUTES=30

# ---------- ارسال ----------
SHIPPING_FEE=50000
FREE_SHIPPING_MIN_AMOUNT=2000000

# ---------- امنیت (مقادیر production) ----------
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# ---------- لاگ ----------
LOG_LEVEL=INFO
