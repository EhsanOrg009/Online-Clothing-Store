#!/bin/sh
# The manual operation uses exactly the scheduler's image, mount and lock.
# Configure BACKUP_HOST_DIR in the private production env; no second destination
# is accepted because it would bypass the shared directory lock and retention.
set -eu
umask 077
backup_project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$backup_project_root"
if [ "$#" -ne 0 ]; then
    printf 'Usage: scripts/backup-production-db (set BACKUP_HOST_DIR in the production environment)\n' >&2
    exit 2
fi
exec scripts/compose-production run --rm --no-deps -T db-backup backup
