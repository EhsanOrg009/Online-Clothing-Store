# Copy to .env.production, set unique secrets, then chmod 600 .env.production.
SECRET_KEY=REPLACE_WITH_AT_LEAST_50_RANDOM_CHARACTERS
DATABASE_NAME=clothing_shop
DATABASE_USER=shop
DATABASE_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
MARIADB_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_STRONG_ROOT_PASSWORD

SITE_URL=https://minikandoo.ir
API_URL=https://api.minikandoo.ir
ALLOWED_HOSTS=minikandoo.ir,www.minikandoo.ir,api.minikandoo.ir,localhost
CSRF_TRUSTED_ORIGINS=https://minikandoo.ir,https://www.minikandoo.ir

# Match this subnet to the static Nginx IP below; ensure it does not overlap
# with existing host/VPN networks. Configure the VPS firewall to allow only
# public TCP 80/443; do not publish database, Redis, or Django ports.
PROXY_SUBNET=172.30.50.0/24
NGINX_PROXY_IP=172.30.50.2
APP_SUBNET=172.30.51.0/24
HTTP_BIND=0.0.0.0
HTTPS_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

DATABASE_CONN_MAX_AGE=60
SHIPPING_FEE=50000
FREE_SHIPPING_MIN_AMOUNT=2000000
SHIPPING_METHOD_NAME=ارسال پست پیشتاز
MAX_QUANTITY_PER_ITEM=10
ORDER_RESERVATION_MINUTES=30
SESSION_COOKIE_AGE=2592000

# Configure SMS.ir provider for sending OTP in production.
SMS_PROVIDER=sms_ir
SMS_IR_API_KEY=
SMS_IR_TEMPLATE_ID=
SMS_IR_OTP_PARAMETER_NAME=Code
SMS_IR_TIMEOUT_SECONDS=10
# Legacy SMS configuration (optional)
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=
PAYMENT_GATEWAY=zibal
# Empty preserves legacy Zibal; enable credit checkout with zibal,torobpay.
PAYMENT_GATEWAYS=
# Required: the merchant identifier from the Zibal panel; test merchant is forbidden here.
ZIBAL_MERCHANT=
ZIBAL_TIMEOUT_SECONDS=10
# No default: set only after written Zibal confirmation of its IANA timezone.
ZIBAL_PAID_AT_TIMEZONE=
# Obtain all four credentials from the active TorobPay merchant account.
TOROBPAY_CLIENT_ID=
TOROBPAY_CLIENT_SECRET=
TOROBPAY_USERNAME=
TOROBPAY_PASSWORD=
TOROBPAY_BASE_URL=https://cpg.torobpay.com
TOROBPAY_TIMEOUT_SECONDS=10
TOROBPAY_TOKEN_REFRESH_BUFFER_SECONDS=300
TOROBPAY_ALLOWED_PAYMENT_HOSTS=cpg.torobpay.com,torobpay.com

# Host provides storage only; the Compose db-backup service owns scheduling.
BACKUP_HOST_DIR=/root/minikandoo-backups
BACKUP_DB_USER=minikandoo_backup
BACKUP_DB_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_BACKUP_PASSWORD
# Match the existing directory owner; leave root-owned production backups intact.
BACKUP_UID=0
BACKUP_GID=0
BACKUP_RETENTION_RECENT=48
BACKUP_RETENTION_DAILY_DAYS=7
# Review `db-backup retention --dry-run` before setting this to apply.
BACKUP_RETENTION_MODE=dry-run
# Blank limits use measured dump estimates for disk safety; set VPS-specific
# limits only after inspecting actual DB/backup sizes and available disk space.
BACKUP_MAX_TOTAL_BYTES=
BACKUP_MIN_FREE_BYTES=
BACKUP_NON_TRANSACTIONAL_POLICY=refuse
BACKUP_COMMAND_TIMEOUT_SECONDS=1200

SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
LOG_LEVEL=INFO
