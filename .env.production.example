# Copy to .env.production, set unique secrets, then chmod 600 .env.production.
SECRET_KEY=REPLACE_WITH_AT_LEAST_50_RANDOM_CHARACTERS
PAYMENT_SECRET=REPLACE_WITH_A_DIFFERENT_50_PLUS_RANDOM_CHARACTERS
DATABASE_NAME=clothing_shop
DATABASE_USER=shop
DATABASE_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
MARIADB_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_STRONG_ROOT_PASSWORD

SITE_URL=https://minikandoo.ir
API_URL=https://api.minikandoo.ir
ALLOWED_HOSTS=minikandoo.ir,www.minikandoo.ir,api.minikandoo.ir,localhost
CSRF_TRUSTED_ORIGINS=https://minikandoo.ir,https://www.minikandoo.ir

# Match this subnet to the static Nginx IP below; ensure it does not overlap
# with existing host/VPN networks. Configure the VPS firewall to allow only
# public TCP 80/443; do not publish database, Redis, or Django ports.
PROXY_SUBNET=172.30.50.0/24
NGINX_PROXY_IP=172.30.50.2
APP_SUBNET=172.30.51.0/24
HTTP_BIND=0.0.0.0
HTTPS_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

DATABASE_CONN_MAX_AGE=60
SHIPPING_FEE=50000
FREE_SHIPPING_MIN_AMOUNT=2000000
SHIPPING_METHOD_NAME=ارسال پست پیشتاز
MAX_QUANTITY_PER_ITEM=10
ORDER_RESERVATION_MINUTES=30
SESSION_COOKIE_AGE=2592000

# The project currently has no production SMS provider or payment gateway.
# `console` SMS and `mock` payment are unsuitable for real customer orders.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=
PAYMENT_GATEWAY=mock
PAYMENT_MERCHANT_ID=
PAYMENT_API_KEY=

SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
LOG_LEVEL=INFO
